FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -o /out/coordinator ./cmd/coordinator && CGO_ENABLED=0 go build -trimpath -o /out/dfsctl ./cmd/dfsctl
FROM alpine:3.22
RUN addgroup -g 10001 dfs && adduser -D -u 10001 -G dfs dfs && mkdir /data && chown dfs:dfs /data
COPY --from=build /out/ /app/
USER dfs
EXPOSE 8080
ENTRYPOINT ["/app/coordinator"]
CMD ["-config", "/config/coordinator.yaml"]
