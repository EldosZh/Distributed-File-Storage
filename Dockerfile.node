FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -o /out/storage-node ./cmd/storage-node
FROM alpine:3.22
RUN addgroup -g 10001 dfs && adduser -D -u 10001 -G dfs dfs && mkdir /data && chown dfs:dfs /data
COPY --from=build /out/storage-node /app/storage-node
USER dfs
EXPOSE 9001
ENTRYPOINT ["/app/storage-node"]
CMD ["-config", "/config/node.yaml"]
